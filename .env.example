# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Zero-setup default. SQLAlchemy picks its behavior (SQLite vs Postgres,
# JSON-column vs real pgvector column, Python-loop vs indexed vector
# search) entirely from this URL's scheme -- see database.py's IS_POSTGRES.
# Application code never needs to change between the two.
DATABASE_URL=sqlite:///./documind.db
# For Postgres (Supabase, Railway Postgres, RDS, Neon, local Postgres, ...),
# use the psycopg (v3) driver explicitly via "+psycopg" and swap the line
# above for this one -- see README.md -> "Migrating to Postgres + pgvector":
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# --- Chunking ---
# CHARACTER counts, not tokens (embedding models/LLMs reason in tokens —
# ~4 chars per token for English as a rough rule of thumb, so 800 chars is
# closer to ~200 tokens). See config.py's comment for why chars, not tokens.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K_RESULTS=4
MIN_SIMILARITY=0.1

# --- Embeddings ---
# Two settings below (EMBEDDING_PROVIDER, EMBEDDING_MODEL_NAME) plus
# EMBEDDING_DIM together choose how documents get turned into vectors.
# requirements.txt does NOT include sentence-transformers or openai — that's
# intentional (see requirements-optional.txt), so pick one:
#
# Development (default, zero extra dependencies):
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
#
# Production — pick ONE of the two real providers instead of the mock block
# above (see README.md "Production setup — real RAG generation" for the
# full explanation of why mock embeddings aren't representative of real
# retrieval quality):
#
#   `pip install -r requirements-optional.txt`, then either:
#
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL_NAME=text-embedding-3-small
#   EMBEDDING_DIM=1536
#   OPENAI_API_KEY=sk-...
#
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
#   EMBEDDING_DIM=384
#   (no API key needed — runs the model on this machine)

# --- LLM / answer generation ---
# Same dev/production split as Embeddings above. requirements.txt does NOT
# include the openai or anthropic packages — intentional, see
# requirements-optional.txt.
#
# Development (default, zero extra dependencies, canned answers):
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#
# Production — pick ONE (`pip install -r requirements-optional.txt` first):
#
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...

# --- OCR: false (default) skips scanned/image-only PDF pages; true needs ---
# --- Tesseract + Poppler installed separately — see README "Enabling OCR" ---
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_MIN_CHARS_PER_PAGE=20
